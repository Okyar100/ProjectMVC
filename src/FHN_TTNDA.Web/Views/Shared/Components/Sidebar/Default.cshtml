@model FHN_TTNDA.Web.Models.Entities.ApplicationUser
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
}

<div class="sidebar-profile">
    <div class="sidebar-avatar">
        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <circle cx="12" cy="8" r="4" stroke="currentColor" stroke-width="1.5"/>
            <path d="M4 20c0-3.3 3.6-6 8-6s8 2.7 8 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
    </div>
    <div class="sidebar-profile-info">
        <div class="sidebar-profile-name">@Model.Ad @Model.Soyad</div>
        <div class="sidebar-profile-row"><i class="bi-mail"></i><span>@Model.UserName</span></div>
        <div class="sidebar-profile-row"><i class="bi-people"></i><span title="@Model.Sobe?.Ad">@(Model.Sobe?.Ad ?? "-")</span></div>
        <div class="sidebar-profile-row"><i class="bi-badge"></i><span title="@Model.Vezife?.Ad">@(Model.Vezife?.Ad ?? "-")</span></div>
        <div class="sidebar-profile-row"><i class="bi-clock"></i><span>@Model.YaradilmaTarixi.ToString("dd.MM.yyyy")</span></div>
    </div>
</div>

<nav class="sidebar-menu">
    <a class="sidebar-link @(currentController == "Users" ? "active" : "")" asp-controller="Users" asp-action="Index">
        <span class="sidebar-icon">&#128101;</span> İstifadəçilər
    </a>
</nav>
