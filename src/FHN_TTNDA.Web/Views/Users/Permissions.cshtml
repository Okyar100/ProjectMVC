@model UserPermissionsViewModel
@{
    ViewData["Title"] = "İstifadəçi İcazələri";
}

<div class="info-bar">
    <div class="info-box">
        <label>İstifadəçi adı</label>
        <strong>@Model.IstifadeciAdi</strong>
    </div>
    <div class="info-box">
        <label>FİN kod</label>
        <strong>@Model.FinKod</strong>
    </div>
</div>

@{
    var tekBolme = Model.Bolmeler.Count <= 1;
}
<div class="@(tekBolme ? "" : "two-col-panels")">
    @if (!tekBolme)
    {
        <div class="panel">
            <div class="bolme-list">
                @foreach (var b in Model.Bolmeler)
                {
                    <a class="bolme-item @(b.Kod == Model.SecilmisBolmeKodu ? "active" : "")"
                       href="@Url.Action("Permissions", new { id = Model.IstifadeciId, bolme = b.Kod })">
                        &#128193; @b.Ad
                    </a>
                }
            </div>
        </div>
    }

    <div class="panel">
        <div class="panel-header">
            <h3>@Model.Bolmeler.First(b => b.Kod == Model.SecilmisBolmeKodu).Ad</h3>
            <span class="badge-count">@Model.Icaze.AktivSayi / @BolmeIcazeItemViewModel.UmumiSayi aktiv</span>
        </div>

        <form asp-action="Permissions" asp-route-id="@Model.IstifadeciId" method="post">
            <input type="hidden" name="bolmeKodu" value="@Model.SecilmisBolmeKodu" />


            <div class="check-row" style="font-weight:500;">
                <input type="checkbox" id="selectAllPermissions" />
                <label for="selectAllPermissions">Hamısını seç</label>
            </div>

            <div class="check-row">
                <input type="checkbox" class="permission-checkbox" id="icazeBaxis" asp-for="Icaze.Baxis" />
                <label for="icazeBaxis">Baxış</label>
            </div>
            <div class="check-row">
                <input type="checkbox" class="permission-checkbox" id="icazeYeni" asp-for="Icaze.Yeni" />
                <label for="icazeYeni">Yeni</label>
            </div>
            <div class="check-row">
                <input type="checkbox" class="permission-checkbox" id="icazeDuzelis" asp-for="Icaze.DuzelisEt" />
                <label for="icazeDuzelis">Düzəliş et</label>
            </div>
            <div class="check-row">
                <input type="checkbox" class="permission-checkbox" id="icazeAktivDeaktiv" asp-for="Icaze.AktivDeaktiv" />
                <label for="icazeAktivDeaktiv">Aktiv/Deaktiv</label>
            </div>
            <div class="check-row">
                <input type="checkbox" class="permission-checkbox" id="icazeIcazeler" asp-for="Icaze.Icazeler" />
                <label for="icazeIcazeler">İcazələr</label>
            </div>

            <div class="form-actions">
                <a class="btn btn-secondary" asp-action="Index">Bağla</a>
                <button type="submit" class="btn btn-success">&#128190; Yadda saxla</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            var baxis = document.getElementById("icazeBaxis");
            var diger = [
                document.getElementById("icazeYeni"),
                document.getElementById("icazeDuzelis"),
                document.getElementById("icazeAktivDeaktiv"),
                document.getElementById("icazeIcazeler")
            ];

            if (!baxis) return;

            // Hər hansı digər icazə seçiləndə, Baxış avtomatik işarələnir
            diger.forEach(function(cb) {
                if (!cb) return;
                cb.addEventListener("change", function() {
                    if (cb.checked) baxis.checked = true;
                });
            });

            // Baxış geri götürüləndə, digər bütün icazələr də geri götürülür
            baxis.addEventListener("change", function() {
                if (!baxis.checked) {
                    diger.forEach(function(cb) { if (cb) cb.checked = false; });
                }
            });
        });
    </script>
}